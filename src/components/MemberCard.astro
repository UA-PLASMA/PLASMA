---
import type { Member } from "../lib/content";
import { assetUrl } from "../lib/urls";

interface Props {
  member: Member;
  profile?: boolean;
}

const { member, profile = false } = Astro.props;
const initials = `${member.name.first.charAt(0)}${member.name.last.charAt(0)}`.toUpperCase();
const showProfileBio =
  profile && ["PI", "scientist", "postdoc"].includes(member.position) && Boolean(member.bio.trim());
const showStudentOrAlumniBio =
  (member.alumni || ["phd", "masters", "undergraduate"].includes(member.position)) &&
  Boolean(member.bio.trim());
const graduateProgram =
  !member.alumni && (member.position === "phd" || member.position === "masters")
    ? member.position === "phd"
      ? "PhD"
      : "Master's"
    : undefined;
---

<article class:list={["member-card", profile && "member-card--profile"]}>
  <div class="member-card__media">
    <div class="member-card__portrait">
      {
        member.image && (
          <img
            src={assetUrl(member.image)}
            alt={`Portrait of ${member.name.first} ${member.name.last}`}
            loading="lazy"
            data-member-image
          />
        )
      }
      <span class="member-card__placeholder" aria-hidden="true">{initials}</span>
    </div>
    {member.imageAiGenerated && <p class="image-generated-label">Image generated by AI</p>}
  </div>
  <div class="member-card__content">
    <h3>
      {member.title && <span class="member-card__title">{member.title} </span>}
      {member.name.first} {member.name.last}
    </h3>
    {
      graduateProgram && (
        <p class="member-card__program">
          {graduateProgram} student{member.joinYear > 0 && ` since ${member.joinYear}`}
        </p>
      )
    }
    {
      member.alumni && (member.position === "scientist" || member.position === "postdoc") ? (
        <p class="member-card__degree">
          {member.position === "scientist" ? "Scientist" : "Postdoctoral Fellow"}
        </p>
      ) : member.highestDegree.degree ? (
        <p class="member-card__degree">
          <span class="member-card__degree-name">{member.highestDegree.degree}</span>
          {
            (member.highestDegree.from || member.highestDegree.year > 0) && (
              <span class="member-card__degree-details">
                {member.highestDegree.from}
                {member.highestDegree.from && member.highestDegree.year > 0 && ", "}
                {member.highestDegree.year > 0 && member.highestDegree.year}
              </span>
            )
          }
        </p>
      ) : null
    }
    {showProfileBio && <p class="member-card__bio">{member.bio}</p>}
    {showStudentOrAlumniBio && <p class="member-card__bio">{member.bio}</p>}
    {
      (member.email || member.linkedin || member.orcid) && (
        <div class="member-card__social-links">
          {member.email && !member.alumni && (
            <button
              class="inline-link member-card__social-icon"
              type="button"
              data-copy-email={member.email}
              title={member.email}
              aria-label={`Copy ${member.name.first} ${member.name.last}'s email address`}
            >
              <img
                class="member-card__email-icon"
                src={assetUrl("/media/misc/email-icon-white.svg")}
                alt=""
                aria-hidden="true"
              />
            </button>
          )}
          {member.linkedin && (
            <a
              class="inline-link member-card__social-icon"
              href={member.linkedin}
              target="_blank"
              rel="noreferrer"
              aria-label={`${member.name.first} ${member.name.last} on LinkedIn`}
            >
              <img src={assetUrl("/media/misc/LinkedIn_icon.svg")} alt="" aria-hidden="true" />
            </a>
          )}
          {member.orcid && (
            <a class="inline-link" href={`https://orcid.org/${member.orcid}`} target="_blank" rel="noreferrer">
              ORCID
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<script>
  document.querySelectorAll<HTMLImageElement>("[data-member-image]").forEach((image) => {
    image.addEventListener("error", () => {
      image.classList.add("member-card__image--missing");
    });
  });
</script>
