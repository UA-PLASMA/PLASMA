---
import type { Announcement } from "../lib/content";
import { routeUrl } from "../lib/urls";

interface Props {
  announcements: Announcement[];
}

const { announcements } = Astro.props;

function hrefFor(announcement: Announcement): string {
  if (!announcement.link.internal) {
    return announcement.link.url;
  }

  if (announcement.link.url === "home") {
    return routeUrl();
  }

  if (announcement.link.url.startsWith("news/")) {
    const slug = announcement.link.url.slice("news/".length).replace(/\.toml$/, "");
    return routeUrl(`news#news-${slug}`);
  }

  if (announcement.link.url.startsWith("papers/")) {
    const slug = announcement.link.url.slice("papers/".length).replace(/\.toml$/, "");
    return routeUrl(`publications#paper-${slug}`);
  }

  return routeUrl(announcement.link.url);
}
---

{
  announcements.length > 0 && (
    <section class="announcement-bar" aria-label="Announcements" data-announcement-bar hidden>
      <div class="container">
        {announcements.map((announcement) => (
          <a
            class="announcement-bar__item"
            href={hrefFor(announcement)}
            data-announcement
            data-start={announcement.dates.start}
            data-end={announcement.dates.end}
            target={announcement.link.internal ? undefined : "_blank"}
            rel={announcement.link.internal ? undefined : "noreferrer"}
            hidden
          >
            <span>Announcement</span>
            {announcement.text}
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  )
}

<script is:inline>
  (() => {
    function localIsoDate(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function updateAnnouncementBar() {
      const announcementBar = document.querySelector("[data-announcement-bar]");

      if (!announcementBar) {
        return;
      }

      const today = localIsoDate(new Date());
      let hasActiveAnnouncement = false;

      announcementBar.querySelectorAll("[data-announcement]").forEach((announcement) => {
        const start = announcement.getAttribute("data-start") || "";
        const end = announcement.getAttribute("data-end") || "";
        const isActive = start <= today && today <= end;

        announcement.hidden = !isActive;
        hasActiveAnnouncement = hasActiveAnnouncement || isActive;
      });

      announcementBar.hidden = !hasActiveAnnouncement;
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateAnnouncementBar, { once: true });
    } else {
      updateAnnouncementBar();
    }
  })();
</script>
