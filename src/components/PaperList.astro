---
import type { Paper } from "../lib/content";
import { formatDate } from "../lib/format";
import { assetUrl } from "../lib/urls";

interface Props {
  papers: Paper[];
}

const { papers } = Astro.props;
---

<ol class="paper-list">
  {
    papers.map((paper) => (
      <li class="paper-list__item" id={`paper-${paper.slug}`}>
        {paper.highlightImage ? (
          <div class="paper-list__media">
            <a
              class="paper-list__figure"
              href={assetUrl(paper.highlightImage)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open full-size image for ${paper.title} in a new tab`}
            >
              <img
                src={assetUrl(paper.highlightImage)}
                alt={`Publication figure for ${paper.title}`}
                loading="lazy"
              />
            </a>
            {paper.highlightImageAiGenerated && (
              <p class="image-generated-label">Image generated by AI</p>
            )}
          </div>
        ) : (
          <div class="paper-list__figure paper-list__figure--blank" aria-hidden="true"></div>
        )}
        <div class="paper-list__content">
          <p class="eyebrow">{formatDate(paper.date)} · {paper.journal}</p>
          <h2>{paper.title}</h2>
          <p class="paper-list__authors">
            {paper.authors.map((author) => `${author.first} ${author.last}`).join(", ")}
            {paper.etAl && paper.authors.length > 0 && ", et al."}
          </p>
          <p class="paper-list__links">
            <a class="inline-link" href={`https://doi.org/${paper.doi}`} target="_blank" rel="noreferrer">
              View DOI
            </a>
            {paper.pdf && <a class="inline-link" href={assetUrl(paper.pdf)}>Download PDF</a>}
          </p>
        </div>
      </li>
    ))
  }
</ol>
