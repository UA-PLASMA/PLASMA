---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact">
  <section class="page-hero">
    <div class="container narrow-content">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p>
        For research inquiries and information about the PLASMA group, contact Principal
        Investigator Christophe Vallee.
      </p>
      <button class="button button--primary" type="button" data-copy-email="cvallee@albany.edu">
        cvallee@albany.edu
      </button>
    </div>
  </section>

  <section class="section">
    <div class="container narrow-content contact-note">
      <h2>Visit PLASMA</h2>
      <p>
        PLASMA is a research group at the University at Albany. Department and location details
        will be added here.
      </p>
    </div>
  </section>
</BaseLayout>
