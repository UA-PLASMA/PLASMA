---
import BaseLayout from "../layouts/BaseLayout.astro";
import { researchAreas } from "../lib/content";
import { renderMarkdown } from "../lib/format";
import { assetUrl, routeUrl } from "../lib/urls";
---

<BaseLayout title="Research">
  <section class="research-page">
    <div class="container">
      <h1 class="visually-hidden">Research</h1>
      {
        researchAreas.length > 0 ? (
          <div class="research-list">
            {researchAreas.map((area, index) => (
              <article
                class:list={[
                  "research-topic",
                  { "research-topic--image-left": index % 2 === 1 },
                ]}
              >
                <div class="research-topic__content">
                  <h2>{area.title}</h2>
                  <div
                    class="research-topic__description rich-text"
                    set:html={renderMarkdown(area.description)}
                  />
                  {area.highlights.length > 0 && (
                    <div class="research-topic__highlights">
                      <h3>Selected publications</h3>
                      <ul>
                        {area.highlights.map((paper) => (
                          <li>
                            <a href={routeUrl(`publications#paper-${paper.slug}`)}>
                              {paper.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
                {area.image ? (
                  <div class="research-topic__media">
                    <a
                      class="research-topic__image"
                      href={assetUrl(area.image)}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open full-size image for ${area.title} in a new tab`}
                    >
                      <img
                        src={assetUrl(area.image)}
                        alt={`Research image for ${area.title}`}
                        loading="lazy"
                      />
                    </a>
                    {area.imageAiGenerated && (
                      <p class="image-generated-label">Image generated by AI</p>
                    )}
                  </div>
                ) : (
                  <div class="research-topic__media">
                    <div class="research-topic__placeholder" aria-hidden="true">
                      <span>Image coming soon</span>
                    </div>
                  </div>
                )}
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state">Research areas will be added here.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
