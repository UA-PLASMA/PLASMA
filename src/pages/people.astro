---
import MemberCard from "../components/MemberCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { members, type MemberPosition } from "../lib/content";

const groups: Array<{
  key: string;
  positions?: MemberPosition[];
  alumni?: boolean;
  heading: string;
  profile: boolean;
}> = [
  { key: "pi", positions: ["PI"], heading: "Principal Investigator", profile: true },
  { key: "scientist", positions: ["scientist"], heading: "Scientists", profile: true },
  { key: "postdoc", positions: ["postdoc"], heading: "Postdoctoral Fellows", profile: true },
  { key: "graduate", positions: ["phd", "masters"], heading: "Graduate students", profile: false },
  { key: "undergraduate", positions: ["undergraduate"], heading: "Undergraduate students", profile: false },
  { key: "alumni", alumni: true, heading: "Alumni", profile: false },
];
---

<BaseLayout title="People">
  <section class="page-hero">
    <div class="container narrow-content">
      <p class="eyebrow">Our group</p>
      <h1>People</h1>
      <p>Meet the researchers and students who make up the PLASMA group.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        groups.map((group) => {
          const groupMembers = members.filter((member) =>
            group.alumni
              ? member.alumni
              : !member.alumni && (group.positions?.includes(member.position) ?? false)
          );

          return (
            groupMembers.length > 0 && (
              <section class="people-group" aria-labelledby={`people-${group.key}`}>
                <h2 id={`people-${group.key}`}>{group.heading}</h2>
                <div class:list={["people-grid", group.profile && "people-grid--profiles"]}>
                  {groupMembers.map((member) => (
                    <MemberCard member={member} profile={group.profile} />
                  ))}
                </div>
              </section>
            )
          );
        })
      }
    </div>
  </section>
</BaseLayout>
